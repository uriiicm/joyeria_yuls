---
import { PUBLIC_STORE_NAME } from 'astro:env/client';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${PUBLIC_STORE_NAME}, inicio`}>
      <img src="/logo.webp" alt={PUBLIC_STORE_NAME} width="900" height="262" />
    </a>
    <nav class="site-nav">
      <a href="/#catalogo">Catálogo</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(251 247 241 / 0.86);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .brand img {
    height: 40px;
    width: auto;
  }
  .site-nav a {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
