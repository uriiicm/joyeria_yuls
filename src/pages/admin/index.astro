---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Inicio" active="dashboard">
  <h1 class="page-title">Hola 🤍</h1>
  <p class="page-sub">Resumen de tu catálogo.</p>

  <div class="stats">
    <div class="stat card"><span data-stat="total">—</span><small>Joyas registradas</small></div>
    <div class="stat card"><span data-stat="available">—</span><small>Disponibles</small></div>
    <div class="stat card"><span data-stat="soldOut">—</span><small>Agotadas</small></div>
    <div class="stat card"><span data-stat="pending">—</span><small>Pendientes de IA</small></div>
  </div>

  <a class="btn btn--rose btn--block add" href="/admin/products/new">＋ Agregar joya con foto</a>

  <section class="section">
    <h2>Últimas joyas</h2>
    <div class="list" data-latest><p class="empty-state">Cargando…</p></div>
  </section>
</AdminLayout>

<script>
  import { requireAdminSession } from '../../client/admin-session';
  import { needsProcessing, productRow, subscribeProducts } from '../../client/products';

  await requireAdminSession();
  const set = (k: string, v: number) => {
    const el = document.querySelector(`[data-stat="${k}"]`);
    if (el) el.textContent = String(v);
  };
  const latest = document.querySelector<HTMLElement>('[data-latest]')!;

  subscribeProducts(
    (products) => {
      const active = products.filter((p) => p.status !== 'archived');
      set('total', active.length);
      set('available', active.filter((p) => p.status === 'published' && p.availability === 'available').length);
      set('soldOut', active.filter((p) => p.availability === 'sold_out').length);
      set('pending', active.filter(needsProcessing).length);
      latest.innerHTML = products.length
        ? products.slice(0, 5).map(productRow).join('')
        : '<p class="empty-state">Aún no hay joyas. ¡Agrega la primera!</p>';
    },
    () => (latest.innerHTML = '<p class="empty-state">No se pudieron cargar los datos.</p>'),
  );
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.1rem;
  }
  .stat span {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
  }
  .stat small {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .add {
    margin-top: 1.25rem;
  }
</style>
