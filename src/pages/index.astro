---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import { listCatalog } from '../services/products/catalog.service';
import { CATEGORIES, type CatalogItem } from '../types/product';
import { PUBLIC_STORE_NAME, PUBLIC_STORE_TAGLINE } from 'astro:env/client';

export const prerender = false;

let items: CatalogItem[] = [];
let loadError = false;
try {
  items = await listCatalog();
} catch (err) {
  console.error('[catalog] list', err);
  loadError = true;
}

// La CDN de Vercel sirve una copia por 60 s y la renueva en segundo plano.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const presentCategories = CATEGORIES.filter((c) => items.some((i) => i.category === c));
const description = `${PUBLIC_STORE_TAGLINE}. Descubre el catálogo de ${PUBLIC_STORE_NAME}: anillos, collares, aretes y más.`;
---

<BaseLayout description={description} image={items[0]?.images[0]}>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container hero__inner">
        <p class="eyebrow">Colección</p>
        <h1 class="hero__title"><img src="/logo.webp" alt={PUBLIC_STORE_NAME} width="900" height="262" fetchpriority="high" /></h1>
        <p class="hero__text">{PUBLIC_STORE_TAGLINE}. Cada pieza se elige con cuidado; consulta disponibilidad y detalles directamente por WhatsApp.</p>
        <a class="btn btn--rose" href="#catalogo">Ver catálogo</a>
      </div>
    </section>

    <section id="catalogo" class="container catalog">
      <form class="filters" role="search" data-filters onsubmit="return false">
        <label class="field filters__search">
          <span class="visually-hidden">Buscar</span>
          <input class="input" type="search" name="q" placeholder="Buscar por nombre, código o color" autocomplete="off" />
        </label>
        <div class="filters__row">
          <label class="field">
            <span class="visually-hidden">Categoría</span>
            <select class="input" name="category">
              <option value="">Todas las categorías</option>
              {presentCategories.map((c) => <option value={c}>{c}</option>)}
            </select>
          </label>
          <label class="field">
            <span class="visually-hidden">Disponibilidad</span>
            <select class="input" name="availability">
              <option value="">Toda disponibilidad</option>
              <option value="available">Disponibles</option>
              <option value="sold_out">Agotados</option>
            </select>
          </label>
          <label class="field">
            <span class="visually-hidden">Ordenar</span>
            <select class="input" name="sort">
              <option value="new">Más recientes</option>
              <option value="price-asc">Precio: menor a mayor</option>
              <option value="price-desc">Precio: mayor a menor</option>
            </select>
          </label>
        </div>
      </form>

      <p class="catalog__count muted" data-count aria-live="polite">
        {items.length} {items.length === 1 ? 'pieza' : 'piezas'}
      </p>

      {
        loadError ? (
          <p class="empty">No pudimos cargar el catálogo en este momento. Intenta de nuevo en unos minutos.</p>
        ) : items.length === 0 ? (
          <p class="empty">Muy pronto encontrarás aquí nuestras piezas.</p>
        ) : (
          <div class="grid" data-grid>
            {items.map((item, i) => (
              <ProductCard item={item} eager={i < 4} />
            ))}
          </div>
        )
      }
      <p class="empty" data-no-results hidden>No encontramos piezas con esos filtros.</p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');

  if (form && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product]'));
    const normalize = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

    const apply = () => {
      const data = new FormData(form);
      const q = normalize(String(data.get('q') ?? ''));
      const category = String(data.get('category') ?? '');
      const availability = String(data.get('availability') ?? '');
      const sort = String(data.get('sort') ?? 'new');

      const visible = cards.filter((card) => {
        const ok =
          (!q || normalize(card.dataset.search ?? '').includes(q)) &&
          (!category || card.dataset.category === category) &&
          (!availability || card.dataset.availability === availability);
        card.hidden = !ok;
        return ok;
      });

      const num = (el: HTMLElement, key: 'price' | 'created') => Number(el.dataset[key] ?? 0);
      const sorted = [...cards].sort((a, b) =>
        sort === 'price-asc'
          ? num(a, 'price') - num(b, 'price')
          : sort === 'price-desc'
            ? num(b, 'price') - num(a, 'price')
            : num(b, 'created') - num(a, 'created'),
      );
      grid.append(...sorted);

      if (count) count.textContent = `${visible.length} ${visible.length === 1 ? 'pieza' : 'piezas'}`;
      if (noResults) noResults.hidden = visible.length > 0;
    };

    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
  }
</script>

<style>
  .hero {
    background:
      radial-gradient(120% 80% at 85% 0%, var(--rose-100) 0%, transparent 60%),
      radial-gradient(90% 70% at 0% 100%, var(--beige-100) 0%, transparent 60%);
    border-bottom: 1px solid var(--line);
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }
  .hero__title img {
    width: min(560px, 86vw);
    height: auto;
    margin-block: 0.25rem 0.5rem;
  }
  .hero__text {
    max-width: 52ch;
    color: var(--ink-soft);
    font-weight: 300;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  .catalog {
    padding-top: 2.5rem;
  }
  .filters {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .filters__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (max-width: 640px) {
    .filters__row {
      grid-template-columns: 1fr 1fr;
    }
    .filters__row .field:last-child {
      grid-column: 1 / -1;
    }
  }
  .catalog__count {
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 1.5rem);
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
</style>
