---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/ui/SiteHeader.astro';
import SiteFooter from '../../components/ui/SiteFooter.astro';
import ProductGallery from '../../components/products/ProductGallery.astro';
import { getCatalogItem } from '../../services/products/catalog.service';
import { AVAILABILITY_LABEL, formatPrice } from '../../lib/utils/format';
import { whatsappLink } from '../../lib/utils/whatsapp';
import Icon from '../../components/ui/Icon.astro';
import AddedToCartModal from '../../components/catalog/AddedToCartModal.astro';
import { PUBLIC_CURRENCY, PUBLIC_FREE_SHIPPING_MIN, PUBLIC_STORE_NAME } from 'astro:env/client';

export const prerender = false;

const item = await getCatalogItem(Astro.params.id ?? '');
// Astro responde con la página 404 (pre-renderizada) cuando la respuesta es 404 sin cuerpo.
if (!item) return new Response(null, { status: 404, statusText: 'Not found' });

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const wa = whatsappLink(item);
const soldOut = item.availability === 'sold_out';
// Datos mínimos para el carrito del visitante (se guardan en su navegador).
const cartItem = {
  id: item.id,
  code: item.code,
  name: item.name,
  price: item.price,
  image: item.thumbnails?.[0] ?? item.images[0] ?? '/placeholder-jewelry.svg',
  url: new URL(`/producto/${item.id}`, Astro.url.origin).href,
};
const details = [
  ['Categoría', item.category],
  ['Material aparente', item.apparentMaterial],
  ['Color', item.colors.join(', ')],
  ['Piedra o detalle', item.stone],
  ['Estilo', item.style],
].filter((row): row is [string, string] => Boolean(row[1]));

const seoDescription = `${item.name} · ${formatPrice(item.price)}. ${item.description}`.slice(0, 200);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: item.name,
  sku: item.code,
  image: item.images,
  description: item.description,
  category: item.category,
  brand: { '@type': 'Brand', name: PUBLIC_STORE_NAME },
  offers: {
    '@type': 'Offer',
    price: item.price,
    priceCurrency: PUBLIC_CURRENCY,
    availability: soldOut ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    url: Astro.url.href,
  },
};
---

<BaseLayout title={item.name} description={seoDescription} image={item.images[0]} type="product">
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(item.price)} />
    <meta property="product:price:currency" content={PUBLIC_CURRENCY} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader />

  <main class="container product">
    <a href="/#catalogo" class="back">← Volver al catálogo</a>

    <div class="product__layout">
      <ProductGallery images={item.images} thumbnails={item.thumbnails} alt={item.name} />

      <section class="product__info fade-in">
        <p class="eyebrow">{item.category}</p>
        <h1 class="product__name">{item.name}</h1>
        <p class="product__code">Código {item.code}</p>
        <p class="product__price">{formatPrice(item.price)}</p>
        <span class={`badge badge--${item.availability}`}>{AVAILABILITY_LABEL[item.availability]}</span>

        {item.description && <p class="product__description">{item.description}</p>}

        {
          details.length > 0 && (
            <dl class="product__details">
              {details.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          item.features.length > 0 && (
            <ul class="product__features">
              {item.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )
        }

        <div class="product__actions">
          {
            soldOut ? (
              <button class="btn btn--block" type="button" disabled>
                Agotado
              </button>
            ) : (
              <button class="btn btn--whatsapp btn--block btn--buy" type="button" data-add-to-cart={JSON.stringify(cartItem)}>
                <Icon name="cart" />
                <span data-add-label>Agregar al carrito</span>
              </button>
            )
          }
          {
            wa && (
              <a class="btn btn--ghost btn--block" href={wa} target="_blank" rel="noopener">
                <Icon name="whatsapp" />
                {soldOut ? 'Preguntar si volverá a estar disponible' : 'Tengo una pregunta'}
              </a>
            )
          }
        </div>
        {
          !soldOut && (
            <div class="urgency">
              <p class="urgency__main">
                <span class="urgency__dot" aria-hidden="true" />
                <strong>Pieza única:</strong> solo hay una disponible. Cuando alguien la pide, sale del catálogo.
              </p>
              {PUBLIC_FREE_SHIPPING_MIN > 0 && (
                <p class="urgency__ship">Envío gratis en pedidos desde {formatPrice(PUBLIC_FREE_SHIPPING_MIN)}.</p>
              )}
            </div>
          )
        }
        <p class="product__note muted">Las características se describen según la apariencia de la pieza.</p>
      </section>
    </div>
  </main>

  <SiteFooter />
  <AddedToCartModal />
</BaseLayout>

<script>
  import { CART_EVENT, addToCart, isInCart, type CartItem } from '../../client/cart';

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((button) => {
    const item = JSON.parse(button.dataset.addToCart!) as CartItem;
    const label = button.querySelector<HTMLElement>('[data-add-label]')!;

    // Si ya está en el carrito, el botón lo indica y abre el carrito.
    const sync = () => {
      const inCart = isInCart(item.id);
      label.textContent = inCart ? 'En tu carrito · Ver carrito' : 'Agregar al carrito';
      button.classList.toggle('is-in-cart', inCart);
    };
    sync();
    window.addEventListener(CART_EVENT, sync);

    button.addEventListener('click', () => {
      if (addToCart(item)) window.dispatchEvent(new CustomEvent('cart:added', { detail: item }));
      else window.dispatchEvent(new CustomEvent('cart:open'));
    });
  });
</script>

<style>
  .product {
    padding-top: 1.25rem;
  }
  .back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .product__layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .product__layout {
      grid-template-columns: 1.15fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
    .product__info {
      position: sticky;
      top: 88px;
    }
  }
  .product__info {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .product__name {
    font-size: clamp(2rem, 6vw, 2.8rem);
  }
  .product__code {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .product__price {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--ink);
  }
  .product__description {
    color: var(--ink-soft);
    font-weight: 300;
    font-size: 1.05rem;
    margin-top: 0.5rem;
  }
  .product__details {
    width: 100%;
    margin: 0.5rem 0;
    border-top: 1px solid var(--line);
  }
  .product__details div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .product__details dt {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .product__details dd {
    margin: 0;
  }
  .product__features {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }
  .product__features li::marker {
    color: var(--gold);
  }
  .product__actions {
    display: grid;
    gap: 0.6rem;
    width: 100%;
  }
  .btn--buy {
    min-height: 52px;
    font-size: 1rem;
  }
  .btn--buy.is-in-cart {
    --bg: var(--white-warm);
    --fg: #3f7156;
    border-color: #bcd3c4;
  }
  .urgency {
    width: 100%;
    display: grid;
    gap: 0.35rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    background: #fbf5ea;
    border: 1px solid #f0e4cc;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .urgency__main {
    padding-left: 1.05rem;
    position: relative;
  }
  .urgency__dot {
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0 rgb(176 141 87 / 0.5);
    animation: pulse 2s infinite;
    transform: translateY(-1px);
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px rgb(176 141 87 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(176 141 87 / 0);
    }
  }
  .urgency__ship {
    padding-left: 1.05rem;
    color: var(--muted);
  }
  .product__note {
    font-size: 0.78rem;
  }
</style>
