# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a Git. Las variables sin PUBLIC_ son secretas
# y solo existen en el servidor (endpoints de Astro / Vercel).
# ─────────────────────────────────────────────────────────────

# Firebase · configuración web (pública; se obtiene con
# `npx firebase-tools apps:sdkconfig WEB` o en Configuración del proyecto)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Tienda
PUBLIC_STORE_NAME=Mi Joyería
PUBLIC_STORE_TAGLINE=Piezas delicadas para cada momento
# Formato internacional sin "+" ni espacios (México: 52 + 1 + 10 dígitos)
PUBLIC_WHATSAPP_NUMBER=5215512345678
PUBLIC_CURRENCY=MXN
# Envío gratis a partir de este monto (0 = sin aviso)
PUBLIC_FREE_SHIPPING_MIN=500
# Video del banner principal (MP4 sin sonido; vacío = solo imagen)
PUBLIC_HERO_VIDEO_URL=https://pub-xxxxxxxx.r2.dev/video/banner.mp4
# URL pública final (para enlaces canónicos y Open Graph). Opcional en local.
PUBLIC_SITE_URL=

# Cloudflare R2 · almacenamiento de fotografías
R2_ACCOUNT_ID=
R2_BUCKET=joyeria
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dominio público del bucket (r2.dev o propio), sin "/" final
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Firebase Admin (servidor). Lo llena `npm run set-admin`.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# UIDs autorizados como administradora, separados por coma. Lo llena `npm run set-admin`.
ADMIN_UIDS=

# Gemini (análisis de fotos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Higgsfield (imágenes publicitarias). Formato: <key-id>:<key-secret>
HIGGSFIELD_API_KEY=
# marketing-studio/image | alibaba/qwen-image-3/edit
HIGGSFIELD_MODEL=marketing-studio/image
