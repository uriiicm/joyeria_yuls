{
  "rules": {
    ".read": false,
    ".write": false,

    "catalog": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["createdAt", "category"]
    },

    "products": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["createdAt", "code"]
    },

    "counters": {
      ".read": false,
      ".write": false
    }
  }
}
